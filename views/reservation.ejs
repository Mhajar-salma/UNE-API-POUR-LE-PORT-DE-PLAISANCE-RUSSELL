<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Détail réservation</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <button class="logout-btn" onclick="logout()">Déconnexion</button>
    <h1>Détail de la réservation</h1>
    <nav>
      <a href="/dashboard">Tableau de bord</a>
      <a href="/reservations-list">Liste des réservations</a>
    </nav>
    <div id="content"></div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    requireAuth();
    (async () => {
      const params = new URLSearchParams(window.location.search);
      const catway = params.get('catway');
      const id = params.get('id');
      if (!catway || !id) {
        document.getElementById('content').textContent = 'Paramètres manquants (utilisez ?catway=N&id=ID)';
        return;
      }
      const { status, data } = await apiCall(`/catways/${catway}/reservations/${id}`, 'GET');
      if (status === 200) {
        const checkIn = new Date(data.checkIn).toLocaleDateString('fr-FR');
        const checkOut = new Date(data.checkOut).toLocaleDateString('fr-FR');
        document.getElementById('content').innerHTML = `
          <p><strong>Catway :</strong> ${data.catwayNumber}</p>
          <p><strong>Client :</strong> ${data.clientName}</p>
          <p><strong>Bateau :</strong> ${data.boatName}</p>
          <p><strong>Arrivée :</strong> ${checkIn}</p>
          <p><strong>Départ :</strong> ${checkOut}</p>
        `;
      } else {
        document.getElementById('content').textContent = data.error || 'Réservation non trouvée';
      }
    })();
  </script>
</body>
</html>
